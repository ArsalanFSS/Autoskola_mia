@import url('https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap');

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: 'Inter', sans-serif;
  color: #1c2023;
  background: #f6f5f0;
  line-height: 1.6;
}

h1, h2, h3, h4 {
  font-family: 'Oswald', sans-serif;
  font-weight: 600;
  margin: 0 0 10px 0;
}
h1 { font-size: 44px; text-transform: uppercase; }
h2 { font-size: 32px; text-transform: uppercase; }
h3 { font-size: 20px; }

p {
  margin: 0 0 15px 0;
  color: #5b6169;
}

a {
  color: inherit;
}

img {
  max-width: 100%;
}

.container {
  max-width: 1180px;
  margin: 0 auto;
  padding: 0 20px;
}

/* ---- eyebrow / znacka nad nadpisem ---- */
.eyebrow {
  display: inline-block;
  background: #2e6b4f;
  color: white;
  padding: 6px 14px;
  border-radius: 4px;
  font-family: 'Oswald', sans-serif;
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-bottom: 15px;
}
.eyebrow--dark {
  background: transparent;
  border: 1px solid white;
}

.tag {
  display: inline-block;
  font-family: 'IBM Plex Mono', monospace;
  font-size: 11px;
  padding: 3px 8px;
  border-radius: 4px;
  background: #e8a93b;
  color: #1c2023;
}
.tag--muted {
  background: #ece9e1;
  color: #5b6169;
}
.tag--stop {
  background: #c24b3e;
  color: white;
}

/* ---- tlacitka ---- */
.btn {
  display: inline-block;
  font-family: 'Oswald', sans-serif;
  font-weight: 600;
  text-transform: uppercase;
  font-size: 14px;
  padding: 13px 24px;
  border-radius: 5px;
  text-decoration: none;
  cursor: pointer;
  border: none;
}
.btn--amber {
  background: #e8a93b;
  color: #1c2023;
}
.btn--outline {
  background: transparent;
  border: 1px solid white;
  color: white;
}
.btn--dark {
  background: #1c2023;
  color: white;
}
.btn--sm {
  padding: 9px 16px;
  font-size: 12px;
}

/* ---- hlavicka ---- */
.site-header {
  background: #f6f5f0;
  border-bottom: 1px solid #ddd;
  position: sticky;
  top: 0;
  z-index: 50;
}
.site-header .container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 74px;
}
.brand {
  display: flex;
  align-items: center;
  gap: 10px;
  text-decoration: none;
  color: #1c2023;
}
.brand__mark {
  width: 38px;
  height: 38px;
  border-radius: 8px;
  background: #2e6b4f;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: 'Oswald', sans-serif;
  font-weight: 700;
}
.brand__text {
  font-family: 'Oswald', sans-serif;
  font-weight: 700;
}
.brand__text span {
  display: block;
  font-family: 'Inter', sans-serif;
  font-weight: 400;
  font-size: 11px;
  color: #5b6169;
  text-transform: uppercase;
}

.nav {
  display: flex;
  align-items: center;
  gap: 25px;
}
.nav a {
  text-decoration: none;
  color: #1c2023;
  font-size: 15px;
}
.nav a:hover {
  color: #2e6b4f;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 15px;
}
.nav-toggle {
  display: none;
  background: none;
  border: none;
  cursor: pointer;
}
.nav-toggle span {
  display: block;
  width: 24px;
  height: 2px;
  background: #1c2023;
  margin: 5px 0;
}

@media (max-width: 900px) {
  .nav {
    display: none;
    position: fixed;
    top: 74px;
    left: 0;
    right: 0;
    bottom: 0;
    background: #f6f5f0;
    flex-direction: column;
    align-items: flex-start;
    padding: 30px;
    gap: 20px;
  }
  .nav.is-open {
    display: flex;
  }
  .nav-toggle {
    display: block;
  }
}

/* ---- hero na uvodni strance ---- */
.hero {
  background: #1c2023;
  color: white;
  padding: 80px 0 60px 0;
}
.hero__road {
  display: none; /* graficky prvek uz nepouzivame */
}
.hero__inner {
  max-width: 700px;
}
.hero p.lede {
  color: #ccc;
  font-size: 17px;
  max-width: 550px;
}
.hero__cta {
  display: flex;
  gap: 15px;
  flex-wrap: wrap;
  margin-top: 25px;
}

.hero__band {
  margin-top: 45px;
  background: #33393e;
  border-radius: 8px;
  padding: 20px 25px;
  display: flex;
  flex-wrap: wrap;
  gap: 20px 40px;
  align-items: center;
  justify-content: space-between;
}
.hero__band .price {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 18px;
  font-weight: 600;
}
.hero__band .price small {
  display: block;
  font-family: 'Inter', sans-serif;
  font-weight: 400;
  font-size: 11px;
  color: #999;
  text-transform: uppercase;
}
.hero__meta {
  display: flex;
  gap: 30px;
  flex-wrap: wrap;
  font-size: 14px;
}
.hero__meta strong {
  display: block;
  font-family: 'Oswald', sans-serif;
  font-size: 11px;
  text-transform: uppercase;
  color: #999;
  margin-bottom: 3px;
}

/* ---- hero na podstrankach ---- */
.page-hero {
  background: #1c2023;
  color: white;
  padding: 55px 0 45px 0;
}
.page-hero p {
  color: #ccc;
  max-width: 600px;
  margin-bottom: 0;
}
.page-hero__road {
  display: none;
}

.lane-divider {
  border-top: 2px dashed #ccc;
  margin: 0;
}

/* ---- sekce ---- */
.section {
  padding: 60px 0;
}
.section--tight {
  padding: 40px 0;
}
.section--alt {
  background: #ece9e1;
}
.section--dark {
  background: #1c2023;
  color: white;
}
.section--dark h2, .section--dark h3 {
  color: white;
}
.section--dark p {
  color: #ccc;
}
.section-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 20px;
  flex-wrap: wrap;
  margin-bottom: 35px;
}
.section-head p {
  max-width: 420px;
  margin: 0;
}

/* ---- karty ---- */
.grid {
  display: grid;
  gap: 20px;
}
.grid--2 { grid-template-columns: 1fr 1fr; }
.grid--3 { grid-template-columns: 1fr 1fr 1fr; }
.grid--4 { grid-template-columns: 1fr 1fr 1fr 1fr; }
@media (max-width: 900px) {
  .grid--3, .grid--4 { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 600px) {
  .grid--2, .grid--3, .grid--4 { grid-template-columns: 1fr; }
}

.card {
  background: white;
  border: 1px solid #ddd;
  border-left: 4px solid #2e6b4f;
  border-radius: 8px;
  padding: 25px;
}
.card__icon {
  width: 44px;
  height: 44px;
  border-radius: 8px;
  background: #e7f0ea;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 15px;
}
.card__icon svg {
  width: 22px;
  height: 22px;
  stroke: #1f4e39;
}
.card__link {
  font-weight: 600;
  font-size: 14px;
  text-decoration: none;
  color: #1f4e39;
}

/* ---- kroky (jak to probiha) ---- */
.steps {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 1fr;
  gap: 15px;
}
@media (max-width: 900px) {
  .steps { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 560px) {
  .steps { grid-template-columns: 1fr; }
}
.step {
  background: white;
  border: 1px solid #ddd;
  border-radius: 8px;
  padding: 20px;
}
.step span.krok {
  display: inline-block;
  font-family: 'IBM Plex Mono', monospace;
  font-size: 12px;
  background: #1c2023;
  color: white;
  padding: 3px 8px;
  border-radius: 4px;
  margin-bottom: 12px;
}
.step h3 {
  font-size: 17px;
}
.step p {
  font-size: 14px;
  margin: 0;
}

/* ---- pilire ---- */
.pillars {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 20px;
}
@media (max-width: 800px) {
  .pillars { grid-template-columns: 1fr; }
}
.pillar {
  padding: 20px;
  border: 1px solid #444;
  border-radius: 8px;
  background: #282e32;
}
.pillar__num {
  font-family: 'IBM Plex Mono', monospace;
  color: #e8a93b;
  font-size: 13px;
  display: block;
  margin-bottom: 8px;
}

/* ---- akordeon (rozbalovaci polozky) ---- */
.acc-group {
  margin-bottom: 12px;
  border: 1px solid #ddd;
  border-radius: 8px;
  background: white;
}
.acc-group__head {
  width: 100%;
  text-align: left;
  background: none;
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  padding: 18px 20px;
  font-family: inherit;
}
.acc-group__title {
  display: flex;
  align-items: center;
  gap: 12px;
}
.acc-group__code {
  font-family: 'Oswald', sans-serif;
  font-weight: 700;
  background: #2e6b4f;
  color: white;
  min-width: 40px;
  text-align: center;
  padding: 5px 4px;
  border-radius: 5px;
}
.acc-group__code.is-stopped {
  background: #c24b3e;
}
.acc-group__meta h3 {
  margin: 0 0 2px 0;
  font-size: 16px;
}
.acc-group__meta span {
  font-size: 13px;
  color: #5b6169;
}
.acc-group__plus {
  font-size: 22px;
  font-weight: 300;
}
.acc-group__facts {
  padding: 0 20px 15px 20px;
  margin-top: -8px;
}
.acc-group__facts span {
  font-size: 12px;
  background: #ece9e1;
  color: #5b6169;
  padding: 4px 8px;
  border-radius: 4px;
  margin-right: 5px;
}
.acc-group__body {
  display: none;
  padding: 0 20px 20px 20px;
  border-top: 1px dashed #ccc;
}
.acc-group.is-open .acc-group__body {
  display: block;
}
.acc-group__body p {
  margin: 15px 0 10px 0;
  font-size: 14px;
}
.acc-group__body ul {
  margin: 0 0 10px 0;
  padding-left: 20px;
  font-size: 14px;
  color: #5b6169;
}
.acc-group__body li {
  margin-bottom: 7px;
}

/* ---- taby ---- */
.tabs {
  display: flex;
  gap: 10px;
  margin-bottom: 30px;
  flex-wrap: wrap;
}
.tab-btn {
  font-family: 'Oswald', sans-serif;
  font-weight: 600;
  text-transform: uppercase;
  font-size: 13px;
  padding: 10px 20px;
  border-radius: 5px;
  border: 1px solid #ccc;
  background: white;
  cursor: pointer;
  color: #5b6169;
}
.tab-btn.is-active {
  background: #2e6b4f;
  border-color: #2e6b4f;
  color: white;
}
.tab-panel {
  display: none;
}
.tab-panel.is-active {
  display: block;
}

/* ---- tabulky s cenami ---- */
.price-table {
  width: 100%;
  border-collapse: collapse;
  background: white;
  margin-bottom: 5px;
}
.price-table th, .price-table td {
  text-align: left;
  padding: 12px 15px;
  font-size: 14px;
  border-bottom: 1px solid #eee;
}
.price-table thead th {
  background: #1c2023;
  color: white;
  font-family: 'Oswald', sans-serif;
  text-transform: uppercase;
  font-size: 12px;
}
.price-table tbody tr:nth-child(odd) {
  background: #ece9e1;
}
.price-table td:last-child {
  font-family: 'IBM Plex Mono', monospace;
  font-weight: 600;
}
.price-table-wrap {
  overflow-x: auto;
  margin-bottom: 40px;
}
.price-note {
  font-size: 13px;
  color: #999;
  margin-top: -25px;
  margin-bottom: 40px;
}

/* ---- kontakt ---- */
.contact-grid {
  display: grid;
  grid-template-columns: 1fr 1.2fr;
  gap: 30px;
}
@media (max-width: 900px) {
  .contact-grid { grid-template-columns: 1fr; }
}
.contact-card {
  display: flex;
  gap: 12px;
  padding: 15px 0;
  border-bottom: 1px solid #eee;
}
.contact-card__icon {
  width: 38px;
  height: 38px;
  border-radius: 8px;
  background: #e7f0ea;
  display: flex;
  align-items: center;
  justify-content: center;
}
.contact-card__icon svg {
  width: 18px;
  height: 18px;
}
.contact-card h4 {
  margin: 0 0 3px 0;
  font-size: 13px;
  text-transform: uppercase;
  color: #5b6169;
}
.contact-card p {
  margin: 0;
}

.form {
  background: white;
  border: 1px solid #ddd;
  border-radius: 8px;
  padding: 25px;
}
.form-row {
  margin-bottom: 15px;
}
.form-row label {
  display: block;
  font-size: 13px;
  font-weight: 600;
  margin-bottom: 5px;
  color: #5b6169;
}
.form-row input, .form-row textarea, .form-row select {
  width: 100%;
  padding: 10px 12px;
  border: 1px solid #ccc;
  border-radius: 5px;
  font-family: 'Inter', sans-serif;
  font-size: 14px;
  background: #f6f5f0;
}
.form-note {
  font-size: 12px;
  color: #999;
  margin-top: 8px;
  margin-bottom: 0;
}
.map-embed {
  border: 1px solid #ddd;
  border-radius: 8px;
  overflow: hidden;
  margin-top: 35px;
}
.map-embed iframe {
  width: 100%;
  height: 340px;
  border: 0;
  display: block;
}

/* ---- kviz na e-testy strance ---- */
.quiz-card {
  background: white;
  border: 1px solid #ddd;
  border-radius: 8px;
  padding: 25px;
  max-width: 640px;
}
.quiz-card__num {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 12px;
  color: #999;
  margin-bottom: 10px;
  display: block;
}
.quiz-opt {
  display: block;
  width: 100%;
  text-align: left;
  padding: 12px 14px;
  margin-bottom: 8px;
  border: 1px solid #ccc;
  border-radius: 6px;
  background: #f6f5f0;
  cursor: pointer;
  font-family: 'Inter', sans-serif;
  font-size: 14px;
}
.quiz-opt.is-correct {
  border-color: #2e6b4f;
  background: #e7f0ea;
  font-weight: 600;
}
.quiz-opt.is-wrong {
  border-color: #c24b3e;
  background: #fbeae7;
}
.quiz-feedback {
  font-size: 14px;
  font-weight: 600;
}

/* ---- cta box ---- */
.cta-band {
  background: #2e6b4f;
  color: white;
  border-radius: 8px;
  padding: 30px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  flex-wrap: wrap;
}
.cta-band h2 {
  color: white;
  margin-bottom: 5px;
  font-size: 24px;
}
.cta-band p {
  color: #eee;
  margin: 0;
}

/* ---- paticka ---- */
.site-footer {
  background: #1c2023;
  color: #ccc;
  padding: 50px 0 20px 0;
}
.footer-grid {
  display: grid;
  grid-template-columns: 1.4fr 1fr 1fr 1fr;
  gap: 25px;
  margin-bottom: 30px;
}
@media (max-width: 800px) {
  .footer-grid { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 520px) {
  .footer-grid { grid-template-columns: 1fr; }
}
.footer-grid h4 {
  color: white;
  font-family: 'Oswald', sans-serif;
  font-size: 13px;
  text-transform: uppercase;
  margin-bottom: 12px;
}
.footer-grid ul {
  list-style: none;
  margin: 0;
  padding: 0;
}
.footer-grid li {
  margin-bottom: 8px;
}
.footer-grid a {
  text-decoration: none;
  color: #ccc;
  font-size: 14px;
}
.footer-grid a:hover {
  color: #e8a93b;
}
.footer-brand p {
  color: #999;
  font-size: 14px;
  max-width: 280px;
}
.footer-bottom {
  border-top: 1px solid #444;
  padding-top: 15px;
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 8px;
  font-size: 12px;
  color: #777;
}
